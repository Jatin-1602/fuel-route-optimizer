# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Django ---
DEBUG=True
# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- OpenRouteService (free key: https://account.heigit.org/manage/key -> "Basic Key") ---
ORS_API_KEY=
# New HeiGIT gateway (api.openrouteservice.org is deprecated). No trailing slash.
ORS_BASE_URL=https://api.heigit.org
ORS_CONNECT_TIMEOUT_SECONDS=5
ORS_READ_TIMEOUT_SECONDS=20

# --- Storage / cache (defaults shown; leave commented to use them) ---
# DATABASE_URL=sqlite:///db.sqlite3
# CACHE_URL=filecache:///absolute/path/to/.cache
# ROUTE_CACHE_TTL_SECONDS=86400
# GEOCODE_CACHE_TTL_SECONDS=2592000
