{
  "info": {
    "name": "Fuel Route Optimizer",
    "_postman_id": "8f6e2d4c-1b7a-4c1e-9a52-6f0f3b2e7d10",
    "description": "Requests and tests for the Fuel Route Optimizer API. Run top to bottom (Collection Runner). See docs/POSTMAN_GUIDE.md. Route endpoints are throttled (default 30/min): one full run sends 16 route requests, so wait a minute between runs or raise ROUTE_THROTTLE_RATE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 429) {",
          "  pm.test(\"not rate limited (wait 60 s or raise ROUTE_THROTTLE_RATE)\", () => pm.expect.fail(\"429 rate_limited\"));",
          "}",
          "pm.test(\"response time < 15 s\", () => pm.expect(pm.response.responseTime).to.be.below(15000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "map_url",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health (warm-up)",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Loads the station index and gazetteer into memory. Run first.",
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"stations loaded\", () => pm.expect(body.stations_loaded).to.be.above(6000));",
              "pm.test(\"gazetteer loaded\", () => pm.expect(body.places_loaded).to.be.above(40000));",
              "pm.test(\"ORS key configured\", () => pm.expect(body.ors_api_key_configured).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 NYC -> LA (first city-to-city call)",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Coast to coast. Offline geocoding, so at most 1 routing call (0 if already cached).",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=New%20York,%20NY&finish=Los%20Angeles,%20CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"external_api_calls <= 1\", () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
              "pm.test(\"total_fuel_cost > 0\", () => pm.expect(body.summary.total_fuel_cost).to.be.above(0));",
              "pm.test(\"every leg within range\", () => pm.expect(body.summary.largest_leg_miles).to.be.at.most(body.summary.vehicle.max_range_miles));",
              "pm.test(\"stops listed match summary\", () => pm.expect(body.fuel_stops.length).to.eql(body.summary.number_of_stops));",
              "pm.test(\"savings vs corridor average >= 0\", () => pm.expect(body.summary.estimated_savings).to.be.at.least(0));",
              "pm.test(\"trade-off reported\", () => pm.expect(body.summary.pure_cost_optimum.number_of_stops).to.be.at.least(body.summary.number_of_stops));",
              "pm.test(\"retries visible in meta\", () => pm.expect(body.meta.external_api_attempts).to.be.at.least(body.meta.external_api_calls));",
              "pm.collectionVariables.set(\"map_url\", body.map_url);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 NYC -> LA again (cache hit)",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Same request: served from the response cache with zero routing calls.",
        "url": {
          "raw": "{{base_url}}/api/v1/route/?start=New%20York,%20NY&finish=Los%20Angeles,%20CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"external_api_calls == 0\", () => pm.expect(body.meta.external_api_calls).to.eql(0));",
              "pm.test(\"cache_hit == true\", () => pm.expect(body.meta.cache_hit).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Map page for NYC -> LA",
      "request": {
        "method": "GET",
        "header": [],
        "description": "The HTML map for request 02 (its map_url). Open that URL in a browser for the interactive map. 0 routing calls.",
        "url": {
          "raw": "{{base_url}}/api/v1/route/map/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            "map",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Use the exact map_url returned by request 02 (a whole-URL variable is not parsed reliably).",
              "const mapUrl = pm.collectionVariables.get(\"map_url\");",
              "if (mapUrl) { pm.request.url = mapUrl; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"HTML page\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
              "pm.test(\"contains the trip data and Leaflet\", () => { const t = pm.response.text(); pm.expect(t).to.include(\"trip-data\"); pm.expect(t).to.include(\"leaflet\"); });"
            ]
          }
        }
      ]
    },
